# admin-web environment variables — NAMES ONLY. Never commit real values.
# See docs/stages/STAGE_1A_TECHNICAL_PLAN.md §5 for the full reference.

# --- Firebase Web SDK config (browser, NEXT_PUBLIC_ — not secret, but per-environment) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Set to "true" for local development against the Firebase Emulator Suite.
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false

# Auth Emulator address (browser SDK). Predictable default matches
# firebase/firebase.json's configured emulator port — only takes effect when
# NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true above.
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Functions Emulator address (browser SDK) — checkpoint 1A.9, used by the
# /register form's call to the registerClient Callable Function. Same
# "only takes effect when NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true" behavior
# as the Auth Emulator host above.
NEXT_PUBLIC_FIREBASE_FUNCTIONS_EMULATOR_HOST=127.0.0.1:5001

# --- Map provider credentials (browser, NEXT_PUBLIC_) — checkpoint 1B.1-D ---
# Google Maps JavaScript API key for the /admin/map live map preview
# (apps/admin-web/lib/map-preview/google-maps-preview.tsx). Not secret by
# design (restricted via HTTP-referrer/API restrictions in the Google Cloud
# Console, not by hiding the string) — same reasoning as the Firebase Web
# SDK config above. Deliberately left UNSET for local dev/E2E: with no key
# configured, the map preview falls back to a non-interactive summary of
# the current form values instead of failing — see MapPreviewSummary.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=YOUR_REAL_GOOGLE_MAPS_API_KEY

# --- Google Places (server only — never NEXT_PUBLIC_) — checkpoint 1B.4 ---
# Server-side Google Places API key, used exclusively by
# lib/pois/google-places-provider.ts to call the Places API (New) on the
# tenant's behalf (POST /api/map/pois/discover, POST /api/map/pois/import).
# Deliberately NOT NEXT_PUBLIC_ — unlike the map-rendering key above, this
# one is billable per search/lookup and must never be readable from the
# browser. Left UNSET for local dev/E2E: with no key configured (and outside
# the E2E-only fake-provider flag below), Google Places discovery/import is
# simply unavailable — see lib/pois/provider-registry.ts.
GOOGLE_PLACES_API_KEY=

# checkpoint 1B.4, E2E-harness only — never set this outside
# e2e/constants.ts's E2E_APP_ENV. Enables a deterministic, in-process fake
# ExternalPoiProvider (lib/pois/fake-external-provider.ts) so the discovery/
# import E2E suite never makes a real, billable Google Places request. Has
# no effect when GOOGLE_PLACES_API_KEY above is set — a real key always
# wins.
E2E_FAKE_EXTERNAL_POI_PROVIDER=false

# --- Firebase Admin SDK config (server only — never NEXT_PUBLIC_) ---
# Prefer Application Default Credentials where available (deployed environments,
# `gcloud auth application-default login` locally). Only set these if a
# service-account key is genuinely required for local server-side testing.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Auth Emulator address (Admin SDK). This exact variable name is a Firebase
# Admin SDK convention read automatically — no application code references
# it directly. Leave unset in staging/production so the Admin SDK talks to
# real Firebase Authentication there.
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Firestore Emulator address (Admin SDK) — checkpoint 1A.8, used by
# lib/tenant/client-context.ts to load real customer/user/map data. Same
# "convention read automatically" behavior as FIREBASE_AUTH_EMULATOR_HOST
# above. Leave unset in staging/production so the Admin SDK talks to real
# Firestore there.
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# --- CSRF trust boundary (server only — never NEXT_PUBLIC_) ---
# The exact origin (scheme + hostname + port) this app is served from —
# e.g. https://admin.example.com in production, http://127.0.0.1:3100 for
# local E2E. POST /api/auth/session and POST /api/auth/logout reject every
# request whose Origin header doesn't match this exactly; there is no
# fallback if it's unset. See lib/auth/origin-check.ts.
APP_ORIGIN=

# --- Session configuration (centralized here, not hardcoded in application code) ---
# Session cookie lifetime in seconds. Default: 14 days. Not a LOCK NOW architecture
# decision — see docs/stages/STAGE_1A_TECHNICAL_PLAN.md §6/§24 (Amendment 3).
SESSION_COOKIE_MAX_AGE_SECONDS=1209600
