{
  "name": "shared-types",
  "version": "0.1.0",
  "private": true,
  "description": "Framework-agnostic domain types and enums shared across admin-web, tourist-web, and firebase/functions. Zero runtime dependencies by design — see docs/stages/STAGE_1A_TECHNICAL_PLAN.md §2/§14.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "lint": "eslint .",
    "pretypecheck": "pnpm run build",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {},
  "devDependencies": {
    "@eslint/js": "9.18.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "2.1.8"
  }
}
