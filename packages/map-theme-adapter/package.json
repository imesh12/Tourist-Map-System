{
  "name": "map-theme-adapter",
  "version": "0.1.0",
  "private": true,
  "description": "Provider-neutral MapTheme -> Google Maps style translation, shared between admin-web (live preview) and tourist-web (public map) — checkpoint 1B.9. See docs/architecture/MAP_THEME_ARCHITECTURE.md.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "lint": "eslint .",
    "prebuild": "pnpm --filter shared-types run build",
    "pretypecheck": "pnpm run build",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "shared-types": "workspace:*"
  },
  "devDependencies": {
    "@eslint/js": "9.18.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "2.1.8"
  }
}
