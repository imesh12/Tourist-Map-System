rules_version = '2';

// Phase 1A.1 baseline: deny everything by default.
//
// The real claims-based, tenant-isolated rules for `customers/{customerId}`,
// `users/{uid}`, and `maps/{mapId}` are implemented in checkpoint 1A.6 per
// docs/stages/STAGE_1A_TECHNICAL_PLAN.md §12 and §23. Until then, this file
// intentionally allows nothing at all — there is no temporary allow-all rule
// at any point in this project, including during local development (see
// docs/stages/STAGE_1A_TECHNICAL_PLAN.md §12).
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
